#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define FUNC 1
#define MOUSE 2
#define BT 3

/ {
    macros {
        macro01: macro01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7 &kp N6 &kp N5 &kp N0 &kp RET>;
            label = "MACRO01";
        };
        macro02: macro02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp G>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp F &kp N8 &kp F &kp N1 &kp N1 &kp N3 &kp N8 &kp RET>
                ;
            label = "MACRO02";
        };
        macro03: macro03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp S>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp N2 &kp G &kp E &kp N7 &kp Q &kp RET>
                ;
            label = "MACRO03";
        };
        macro04: macro04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp I>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp N &kp O &kp S &kp H &kp I &kp K &kp A &kp N4 &kp N1 &kp N2 &kp N6 &kp RET>
                ;
            label = "MACRO04";
        };
        macro05: macro05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp A>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp N8 &kp J &kp I &kp M &kp N5 &kp N9 &kp N6 &kp N3 &kp RET>
                ;
            label = "MACRO05";
        };
        macro06: macro06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp T>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp E &kp S &kp A>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp S>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp P &kp A &kp T>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp V>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp N5 &kp RET>
                ;
            label = "MACRO06";
        };
        macro07: macro07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp J &kp H &kp N2 &kp D>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp M &kp A &kp H>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp N5 &kp RET>
                ;
            label = "MACRO07";
        };
};

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Def";
            bindings = <
          &kp UP                &kp A    &kp B  &lt 3 ENTER
&kp LEFT  &kp SPACE  &kp RIGHT  &lt 1 C  &kp D  &kp BKSP
          &kp DOWN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN &inc_dec_kp PG_UP PG_DN>;
        };

        func_layer {
            label = "Func";
            bindings = <
          &kp PG_UP           &macro02  &kp B  &kp ENTER
&kp HOME  &kp BKSP   &kp END  &kp C     &kp D  &kp BKSP
          &kp PG_DN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
          &mkp MB3             &mkp MB1  &mkp MB2  &trans
&mkp MB1  &kp BKSP   &mkp MB2  &mkp MB3  &trans    &trans
          &kp PG_DN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN &inc_dec_kp PG_UP PG_DN>;
        };

        bt_layer {
            label = "BT";
            bindings = <
        &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &kp ENTER
&trans  &bt BT_CLR_ALL  &trans  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
